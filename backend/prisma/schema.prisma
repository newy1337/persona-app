generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DashboardUser {
  id                Int      @id @default(autoincrement())
  username          String   @unique
  passwordHash      String   @map("password_hash")
  passwordEncrypted String?  @map("password_encrypted")
  regionCode        String?  @map("region_code")
  role              String   @default("manager")
  lastLogin         Int?     @map("last_login")
  createdAt         Int      @map("created_at")
  canEditPhotoSets  Boolean  @default(false) @map("can_edit_photo_sets")
  /// распределение входящих лидов: берёт только тот, кто онлайн
  online            Boolean  @default(false)
  /// лимит входящих лидов в сутки (МСК); null — без лимита
  leadQuota         Int?     @map("lead_quota")
  /// источники, которые принимает; пусто — любые
  leadSources       String[] @default([]) @map("lead_sources")
  /// личности (slug), которые принимает; пусто — любые
  leadPersonas      String[] @default([]) @map("lead_personas")
  /// получает холодку (лиды из /api/post/cold), если её принимает регион
  coldLeads         Boolean  @default(false) @map("cold_leads")

  voicerId            Int?            @map("voicer_id")
  voicer              DashboardUser?  @relation("ManagerVoicer", fields: [voicerId], references: [id], onDelete: SetNull)
  voicedManagers      DashboardUser[] @relation("ManagerVoicer")
  /// руководитель: у менеджера — тимлид, у тимлида — хед; они видят диалоги подчинённых
  leadId              Int?            @map("lead_id")
  lead                DashboardUser?  @relation("ManagerLead", fields: [leadId], references: [id], onDelete: SetNull)
  subordinates        DashboardUser[] @relation("ManagerLead")
  voiceProfile        VoicerProfile?
  requestedVoiceTasks VoiceTask[]     @relation("TaskManager")
  assignedVoiceTasks  VoiceTask[]     @relation("TaskVoicer")

  accounts         ManagerAccount[]
  audit            DashboardAuditLog[]
  photoAssignments ManagerPhotoSet[]
  donors           ManagerDonor[]

  @@index([leadId], map: "idx_dashboard_users_lead")
  @@map("dashboard_users")
}

model ManagerAccount {
  userId      Int @map("user_id")
  tgAccountId Int @unique @map("tg_account_id")

  user    DashboardUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  account TgAccount     @relation(fields: [tgAccountId], references: [id], onDelete: Cascade)

  @@id([userId, tgAccountId])
  @@index([userId], map: "idx_manager_accounts_user")
  @@map("manager_accounts")
}

model DashboardAuditLog {
  id          Int     @id @default(autoincrement())
  ts          Int
  userId      Int?    @map("user_id")
  action      String
  resource    String?
  payloadJson String? @map("payload_json")
  result      String  @default("success")
  error       String?

  user DashboardUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ts], map: "idx_dashboard_audit_ts")
  @@map("dashboard_audit_log")
}

model Persona {
  id             Int     @id @default(autoincrement())
  slug           String  @unique
  name           String
  isDefault      Boolean @default(false) @map("is_default")
  enabled        Boolean @default(true)
  persona        String  @default("{}")
  goals          String  @default("{}")
  storylines     String  @default("{}")
  dayConfig      String  @default("{}") @map("day_config")
  beats          String?
  prompts        String  @default("{}")
  rhythm         String  @default("{}")
  variables      String  @default("{}")
  notes          String?
  generatorModel String? @map("generator_model")
  judgeModel     String? @map("judge_model")
  /// тип трафика: cold — холодка, hot — горячий; null — не проставлен
  trafficType    String? @map("traffic_type")
  createdAt      Int     @map("created_at")
  updatedAt      Int     @map("updated_at")

  versions PersonaVersion[]

  @@map("personas")
}

model PersonaVersion {
  id        Int     @id @default(autoincrement())
  personaId Int     @map("persona_id")
  section   String
  data      String
  savedBy   String? @map("saved_by")
  note      String?
  createdAt Int     @map("created_at")

  personaRow Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([personaId, section, id], map: "idx_persona_versions")
  @@map("persona_versions")
}

model TgAccount {
  id                   Int     @id @default(autoincrement())
  phoneE164            String  @unique @map("phone_e164")
  personaId            String  @map("persona_id")
  sessionEncrypted     String? @map("session_encrypted")
  proxyConfigEncrypted String? @map("proxy_config_encrypted")
  status               String  @default("unauthorized")
  addedAt              Int     @map("added_at")
  lastLoginAt          Int?    @map("last_login_at")
  lastHeartbeatAt      Int?    @map("last_heartbeat_at")
  bannedAt             Int?    @map("banned_at")
  banReason            String? @map("ban_reason")
  metaJson             String? @map("meta_json")
  needsProxySetup      Int     @default(0) @map("needs_proxy_setup")
  routingWeight        Float   @default(1.0) @map("routing_weight")
  dailyMsgQuota        Int?    @map("daily_msg_quota")
  purpose              String  @default("prod")
  telegramUserId       BigInt? @map("telegram_user_id")
  username             String?
  displayName          String? @map("display_name")
  floodUntil           Int?    @map("flood_until")
  floodReason          String? @map("flood_reason")
  photoSetId           Int?    @map("photo_set_id")
  photoAutoSend        Boolean @default(true) @map("photo_auto_send")

  manager  ManagerAccount?
  photoSet PhotoSet?       @relation(fields: [photoSetId], references: [id], onDelete: SetNull)
  contacts Contact[]

  @@index([personaId, status], map: "idx_tg_persona_status")
  @@index([photoSetId], map: "idx_tg_photo_set")
  @@map("tg_accounts")
}

model Contact {
  chatId             BigInt  @id @map("chat_id")
  accountId          Int?    @map("account_id")
  pauseState         String  @default("active") @map("pause_state")
  pauseReason        String? @map("pause_reason")
  pauseActor         String? @map("pause_actor")
  pausedUntil        Int?    @map("paused_until")
  pausedTs           Int?    @map("paused_ts")
  createdAt          Int     @default(0) @map("created_at")
  readOutboxMaxId    Int?    @map("read_outbox_max_id")
  readInboxMaxId     Int?    @map("read_inbox_max_id")
  clientStatus       String? @map("client_status")
  clientStatusAt     Int?    @map("client_status_at")
  clientStatusSeenAt Int?    @map("client_status_seen_at")
  blockedByClientAt  Int?    @map("blocked_by_client_at")
  managerSeenTs      Int?    @map("manager_seen_ts")
  clearedByClientAt  Int?    @map("cleared_by_client_at")
  note               String? @map("note")
  noteBy             String? @map("note_by")
  noteAt             Int?    @map("note_at")

  /// образ, на котором начался диалог; смена образа в регионе его не меняет
  photoSetId Int? @map("photo_set_id")

  account  TgAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  photoSet PhotoSet?  @relation(fields: [photoSetId], references: [id], onDelete: SetNull)

  @@index([accountId], map: "idx_contacts_account")
  @@index([photoSetId], map: "idx_contacts_photo_set")
  @@map("contacts")
}

model Message {
  id              Int     @id @default(autoincrement())
  chatId          BigInt  @map("chat_id")
  ts              Int
  role            String
  text            String
  author          String  @default("llm")
  sourceMessageId Int?    @map("source_message_id")
  sourceModality  String  @default("text") @map("source_modality")
  tgMsgId         Int?    @map("tg_msg_id")
  mediaKind       String? @map("media_kind")
  filePath        String? @map("file_path")
  replyTo         Int?    @map("reply_to")
  reaction        String?
  deletedAt       Int?    @map("deleted_at")
  editedAt        Int?    @map("edited_at")
  processedAt     Int?    @map("processed_at")
  inboundPayload  String? @map("inbound_payload")
  /// Что было на отправленном фото из образа: модель видит это в истории.
  mediaNote       String? @map("media_note")

  @@unique([chatId, sourceMessageId], map: "uq_messages_chat_source_message")
  @@index([chatId, id], map: "idx_messages_chat")
  @@index([chatId, ts, id], map: "idx_messages_chat_ts")
  @@index([processedAt, role], map: "idx_messages_unprocessed")
  @@map("messages")
}

model LeadFacts {
  chatId BigInt @id @map("chat_id")
  facts  String @default("{}")

  @@map("pinned_facts")
}

model BrainState {
  chatId    BigInt @id @map("chat_id")
  stateJson String @map("state_json")
  updatedAt Int    @map("updated_at")

  @@map("brain_state")
}

model ReplySchedule {
  delivery  String?
  chatId    BigInt  @id @map("chat_id")
  accountId Int     @map("account_id")
  dueAt     Int     @map("due_at")
  baseDueAt Int     @default(0) @map("base_due_at")
  openedAt  Int?    @map("opened_at")
  reason    String
  turns     String  @default("[]")
  createdAt Int     @map("created_at")

  @@index([dueAt], map: "idx_reply_schedule_due")
  @@map("reply_schedule")
}

model PendingReply {
  id             Int            @id @default(autoincrement())
  chatId         BigInt         @map("chat_id")
  text           String
  source         String         @default("manual")
  accountId      Int?           @map("account_id")
  claimedAt      Int?           @map("claimed_at")
  retryAt        Int?           @map("retry_at")
  delivery       String?
  status         String         @default("pending")
  kind           String         @default("text")
  filePath       String?        @map("file_path")
  replyTo        Int?           @map("reply_to")
  createdTs      Int            @map("created_ts")
  sentTs         Int?           @map("sent_ts")
  error          String?
  photoId        Int?           @map("photo_id")
  voicerDelivery VoiceDelivery?

  @@index([chatId, status], map: "idx_pending_replies_status")
  @@index([status, retryAt], map: "idx_pending_replies_retry")
  @@map("pending_replies")
}

model PendingAdminAction {
  id          Int     @id @default(autoincrement())
  chatId      BigInt  @map("chat_id")
  accountId   Int?    @map("account_id")
  action      String
  payload     String  @default("")
  status      String  @default("pending")
  createdTs   Int     @map("created_ts")
  processedTs Int?    @map("processed_ts")
  error       String?

  @@index([chatId, status], map: "idx_admin_actions_status")
  @@map("pending_admin_actions")
}

model BeatDelivery {
  personaId String  @map("persona_id")
  chatId    BigInt  @map("chat_id")
  beat      String
  status    String  @default("delivered")
  turn      Int?
  ts        Float
  by        String
  src       String
  actor     String?
  evidence  String  @default("")
  rubricSha String  @default("") @map("rubric_sha")
  reason    String  @default("")

  @@id([personaId, chatId, beat])
  @@index([chatId], map: "idx_beat_delivery_chat")
  @@map("beat_delivery")
}

model LeadHandoff {
  personaId          String  @map("persona_id")
  chatId             BigInt  @map("chat_id")
  state              String
  holdArmedAt        Int?    @map("hold_armed_at")
  phone              String?
  analystAssignedAt  Int?    @map("analyst_assigned_at")
  contactDeliveredAt Int?    @map("contact_delivered_at")
  closedAt           Int?    @map("closed_at")
  abortReason        String? @map("abort_reason")
  createdAt          Int     @map("created_at")
  updatedAt          Int     @map("updated_at")

  @@id([personaId, chatId])
  @@index([personaId, state], map: "idx_lead_handoff_state")
  @@map("lead_handoff")
}

model FunnelEvent {
  id        Int     @id @default(autoincrement())
  personaId String  @map("persona_id")
  chatId    BigInt? @map("chat_id")
  eventType String  @map("event_type")
  eventMeta String? @map("event_meta")
  ts        Int

  @@index([personaId, ts(sort: Desc)], map: "idx_funnel_persona_ts")
  @@index([chatId, ts(sort: Desc)], map: "idx_funnel_chat_ts")
  @@index([eventType, ts], map: "idx_funnel_type_ts")
  @@map("funnel_events")
}

model MediaShown {
  chatId  BigInt @map("chat_id")
  path    String
  shownTs Float  @map("shown_ts")
  kind    String @default("photo")

  @@id([chatId, path])
  @@map("media_shown")
}

/// Образ: набор фотографий личности. Создаёт и ведёт хед своего региона,
/// он же назначает образ сотрудникам региона (ManagerPhotoSet). Диалог
/// закрепляется за образом, действовавшим при его начале (Contact.photoSetId).
model PhotoSet {
  id             Int     @id @default(autoincrement())
  name           String
  /// регион хеда, который ведёт образ. Общих образов нет; NULL бывает только
  /// у старого неиспользуемого образа — его видит лишь администратор
  regionCode     String? @map("region_code")
  coverPhotoId   Int?    @map("cover_photo_id")
  autoSend       Boolean @default(true) @map("auto_send")
  /// request — только по просьбе собеседника; initiative — ещё и по своей инициативе.
  sendMode       String  @default("initiative") @map("send_mode")
  minIntervalMin Int     @default(120) @map("min_interval_min")
  maxPerDay      Int     @default(2) @map("max_per_day")
  noRepeat       Boolean @default(true) @map("no_repeat")
  /// Удалённый образ, снимки которого уже показывали: скрыт, история цела.
  archivedAt     Int?    @map("archived_at")
  createdAt      Int     @map("created_at")
  updatedAt      Int     @map("updated_at")

  photos      PhotoSetPhoto[]
  accounts    TgAccount[]
  contacts    Contact[]
  assignments ManagerPhotoSet[]

  @@index([regionCode], map: "idx_photo_sets_region")
  @@map("photo_sets")
}

/// Какой образ получают новые диалоги сотрудника. Хед назначает образ своего
/// региона каждому сотруднику — отдельно по каждой личности его аккаунтов.
/// Образы учётки: хед назначает сотруднику образы (сколько угодно), сотрудник
/// привязывает каждый к одной из личностей своих аккаунтов. У личности один
/// действующий образ: новый образ на ту же личность забирает новых
/// собеседников, начатые диалоги остаются на прежнем (Contact.photoSetId).
model ManagerPhotoSet {
  userId      Int     @map("user_id")
  setId       Int     @map("set_id")
  /// личность, к которой сотрудник привязал образ; null — образ в запасе
  personaSlug String? @map("persona_slug")
  updatedAt   Int     @map("updated_at")
  updatedBy   Int?    @map("updated_by")

  user DashboardUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  set  PhotoSet      @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@id([userId, setId])
  @@unique([userId, personaSlug], map: "manager_photo_sets_user_persona_key")
  @@index([setId], map: "idx_manager_photo_sets_set")
  @@map("manager_photo_sets")
}

/// Стоп региона: образы региона выключены. Фото из образов не уходят, запросы
/// фото идут по прежней схеме; остальная автоматика работает.
model RegionStop {
  regionCode String  @id @map("region_code")
  reason     String?
  actorId    Int?    @map("actor_id")
  createdAt  Int     @map("created_at")

  @@map("region_stops")
}

model PhotoSetPhoto {
  id          Int     @id @default(autoincrement())
  setId       Int     @map("set_id")
  filePath    String  @map("file_path")
  thumbPath   String  @map("thumb_path")
  sha256      String
  width       Int     @default(0)
  height      Int     @default(0)
  description String  @default("")
  place       String?
  /// YYYY, YYYY-MM или YYYY-MM-DD; NULL — дата неизвестна.
  takenOn     String? @map("taken_on")
  details     String  @default("")
  tags        String  @default("[]")
  autoSend    Boolean @default(true) @map("auto_send")
  /// false — описание предложено системой и человек его ещё не смотрел.
  reviewed    Boolean @default(false)
  createdAt   Int     @map("created_at")
  updatedAt   Int     @map("updated_at")
  deletedAt   Int?    @map("deleted_at")

  set   PhotoSet    @relation(fields: [setId], references: [id], onDelete: Cascade)
  sends PhotoSend[]

  @@unique([setId, sha256], map: "uq_photo_set_sha")
  @@index([setId, deletedAt], map: "idx_photo_set_photos")
  @@map("photo_set_photos")
}

/// Какие снимки уже видел собеседник. Хранится по чату и фото, а не по
/// аккаунту или менеджеру: смена набора или менеджера отметки не обнуляет.
model PhotoSend {
  id        Int     @id @default(autoincrement())
  chatId    BigInt  @map("chat_id")
  photoId   Int     @map("photo_id")
  accountId Int?    @map("account_id")
  messageId Int?    @unique @map("message_id")
  tgMsgId   Int?    @map("tg_msg_id")
  caption   String  @default("")
  note      String  @default("")
  /// bot | manager
  source    String
  actor     String?
  sentAt    Int     @map("sent_at")

  photo PhotoSetPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([chatId, sentAt], map: "idx_photo_sends_chat")
  @@index([photoId], map: "idx_photo_sends_photo")
  @@map("photo_sends")
}

model InboundMedia {
  id      Int    @id @default(autoincrement())
  chatId  BigInt @map("chat_id")
  msgTs   Float  @map("msg_ts")
  kind    String
  path    String
  savedAt Float  @map("saved_at")

  @@index([chatId, msgTs], map: "idx_inbound_media_chat")
  @@map("inbound_media")
}

model PhoneNumber {
  id                 Int     @id @default(autoincrement())
  phoneE164          String? @unique @map("phone_e164")
  usernameKey        String? @unique @map("username_key")
  firstName          String? @map("first_name")
  city               String?
  age                Int?
  site               String?
  gender             String?
  telegramUserId     BigInt? @map("telegram_user_id")
  telegramUsername   String? @map("telegram_username")
  sourceType         String  @default("manual") @map("source_type")
  insertedAt         Int     @map("inserted_at")
  status             String  @default("pending")
  assignedAccountId  Int?    @map("assigned_account_id")
  preferredAccountId Int?    @map("preferred_account_id")
  assignedAt         Int?    @map("assigned_at")
  firstContactAt     Int?    @map("first_contact_at")
  attempts           Int     @default(0)
  nextAttemptAt      Int?    @map("next_attempt_at")
  lastError          String? @map("last_error")
  notes              String?
  firstMessage       String? @map("first_message")
  avoidAccountId     Int?    @map("avoid_account_id")
  personaId          String? @map("persona_id")
  ownerUserId        Int?    @map("owner_user_id")
  /// входящий лид по API: донор и источник текстом, как прислали
  donor              String?
  /// аккаунт на стороне донора (текст)
  accountLabel       String? @map("account_label")
  /// id лида в системе отправителя
  externalId         String? @map("external_id")
  /// ссылка на профиль в соцсети
  profileUrl         String? @map("profile_url")
  /// история общения, которую прислал донор
  lastMessages       String? @map("last_messages")
  /// когда лид пришёл по API и был распределён (счётчик суточного лимита)
  inboundAt          Int?    @map("inbound_at")
  /// регион, который запросил отправитель; раздача только внутри него
  requestedRegion    String? @map("requested_region")
  /// личность, которую прислал отправитель (как есть, текстом)
  requestedPersona   String? @map("requested_persona")
  /// перезабив: отправитель пометил лид как повторный (reassigned в API)
  reassigned         Boolean @default(false)
  /// холодка: пришёл через /api/post/cold, раздан без региона и личности
  cold               Boolean @default(false)
  /// когда лид попал в буфер (только ник, без телефона); статус 'buffer'
  bufferedAt         Int?    @map("buffered_at")

  @@index([telegramUserId], map: "idx_phone_telegram_user")
  @@index([ownerUserId], map: "idx_phone_owner")
  @@index([status, nextAttemptAt], map: "idx_phone_status_next")
  @@index([assignedAccountId, firstContactAt], map: "idx_phone_account_contact")
  @@index([ownerUserId, inboundAt], map: "idx_phone_owner_inbound")
  @@map("phone_numbers")
}

/// Ключ для внешних систем (входящие лиды). Храним только хеш; сам ключ
/// показывается один раз при создании. Отзыв — revoked_at.
model ApiKey {
  id          Int    @id @default(autoincrement())
  name        String
  keyHash     String @unique @map("key_hash")
  /// первые символы ключа, чтобы узнать его в списке
  prefix      String
  createdAt   Int    @map("created_at")
  createdById Int?   @map("created_by_id")
  lastUsedAt  Int?   @map("last_used_at")
  revokedAt   Int?   @map("revoked_at")

  @@map("api_keys")
}

/// Справочник источников лидов: менеджер выбирает, какие принимает (по имени).
model LeadSource {
  id        Int    @id @default(autoincrement())
  name      String @unique
  createdAt Int    @map("created_at")

  @@map("lead_source_catalog")
}

/// Донор — откуда приходят лиды, как кампания. Менеджер принимает лиды
/// только своих доноров (пусто — любых).
model Donor {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  createdAt Int            @map("created_at")
  managers  ManagerDonor[]

  @@map("donors")
}

model ManagerDonor {
  userId  Int           @map("user_id")
  donorId Int           @map("donor_id")
  user    DashboardUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  donor   Donor         @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@id([userId, donorId])
  @@index([donorId], map: "idx_manager_donors_donor")
  @@map("manager_donors")
}

model AppSettings {
  id                 Int    @id @default(1)
  initiativeEnabled  Int    @default(1) @map("initiative_enabled")
  proactiveMaxPerDay Int    @default(1) @map("proactive_max_per_day")
  quietStart         String @default("23:00") @map("quiet_start")
  quietEnd           String @default("08:00") @map("quiet_end")
  customPrompt       String @default("") @map("custom_prompt")
  updatedAt          Int    @map("updated_at")

  @@map("app_settings")
}

model ModelUsage {
  id                       Int     @id @default(autoincrement())
  createdAt                Int     @map("created_at")
  chatId                   BigInt? @map("chat_id")
  personaId                String? @map("persona_id")
  provider                 String
  model                    String
  stage                    String
  inputTokens              Int?    @map("input_tokens")
  outputTokens             Int?    @map("output_tokens")
  cachedTokens             Int?    @map("cached_tokens")
  cacheWriteTokens         Int?    @map("cache_write_tokens")
  cacheWrite1hTokens       Int?    @map("cache_write_1h_tokens")
  providerEstimatedCostUsd Float?  @map("provider_estimated_cost_usd")
  elapsedMs                Int?    @map("elapsed_ms")

  @@index([createdAt], map: "idx_model_usage_created")
  @@map("model_usage")
}

model Setting {
  key       String @id
  value     String @default("{}")
  updatedAt Int    @map("updated_at")

  @@map("settings")
}

model VoicerProfile {
  userId           Int           @id @map("user_id")
  telegramId       BigInt?       @unique @map("telegram_id")
  telegramUsername String?       @map("telegram_username")
  linkHash         String?       @unique @map("link_hash")
  linkExpiresAt    Int?          @map("link_expires_at")
  user             DashboardUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("voicer_profiles")
}

model VoiceTask {
  source               String               @default("manager")
  autoKey              String?              @unique @map("auto_key")
  autoReplyId          String?              @map("auto_reply_id")
  autoContextId        Int?                 @map("auto_context_id")
  autoContextHash      String?              @map("auto_context_hash")
  autoExpiresAt        Int?                 @map("auto_expires_at")
  autoPersonaUpdatedAt Int?                 @map("auto_persona_updated_at")
  id                   Int                  @id @default(autoincrement())
  managerId            Int?                 @map("manager_id")
  voicerId             Int?                 @map("voicer_id")
  managerName          String               @map("manager_name")
  voicerName           String               @map("voicer_name")
  manager              DashboardUser?       @relation("TaskManager", fields: [managerId], references: [id], onDelete: SetNull)
  voicer               DashboardUser?       @relation("TaskVoicer", fields: [voicerId], references: [id], onDelete: SetNull)
  kind                 String
  voiceMode            String               @default("library") @map("voice_mode")
  sendAccountId        Int?                 @map("send_account_id")
  sendRequestedById    Int?                 @map("send_requested_by_id")
  title                String
  script               String               @default("")
  emotion              String               @default("")
  tempo                String               @default("")
  instructions         String               @default("")
  contactLabel         String               @map("contact_label")
  contactRef           String               @default("") @map("contact_ref")
  chatId               BigInt?              @map("chat_id")
  chatGrantAccountId   Int?                 @map("chat_grant_account_id")
  chatGrantedById      Int?                 @map("chat_granted_by_id")
  personaSlug          String               @map("persona_slug")
  personaName          String               @map("persona_name")
  biography            String
  status               String               @default("queued")
  priority             Int                  @default(0)
  revision             Int                  @default(1)
  feedback             String               @default("")
  outcome              String               @default("")
  createdAt            Int                  @map("created_at")
  updatedAt            Int                  @map("updated_at")
  dueAt                Int?                 @map("due_at")
  notifyVersion        Int                  @default(1) @map("notify_version")
  notifiedVersion      Int                  @default(0) @map("notified_version")
  notifyAfter          Int                  @default(0) @map("notify_after")
  notifyError          String?              @map("notify_error")
  botMessageId         Int?                 @map("bot_message_id")
  botChatId            BigInt?              @map("bot_chat_id")
  calls                VoiceCall[]
  callRecordings       VoiceCallRecording[]
  recordings           VoiceRecording[]
  deliveries           VoiceDelivery[]
  notices              VoiceNotice[]

  @@index([managerId, status, id])
  @@index([voicerId, status, priority, id])
  @@index([source, status, autoExpiresAt])
  @@map("voice_tasks")
}

model VoiceRecording {
  id                Int             @id @default(autoincrement())
  taskId            Int             @map("task_id")
  revision          Int
  title             String
  filePath          String          @map("file_path")
  duration          Int
  createdAt         Int             @map("created_at")
  telegramMessageId Int             @map("telegram_message_id")
  telegramChatId    BigInt          @map("telegram_chat_id")
  task              VoiceTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  deliveries        VoiceDelivery[]

  @@unique([taskId, revision])
  @@unique([telegramChatId, telegramMessageId])
  @@map("voice_recordings")
}

model VoiceNotice {
  id        Int       @id @default(autoincrement())
  taskId    Int       @map("task_id")
  userId    Int       @map("user_id")
  eventKey  String    @map("event_key")
  text      String
  createdAt Int       @map("created_at")
  readAt    Int?      @map("read_at")
  task      VoiceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId, readAt, id])
  @@map("voice_notices")
}

model VoiceDelivery {
  notifiedStatus String         @default("") @map("notified_status")
  id             Int            @id @default(autoincrement())
  taskId         Int            @map("task_id")
  recordingId    Int            @map("recording_id")
  requestKey     String         @unique @map("request_key")
  mode           String
  requestedById  Int            @map("requested_by_id")
  chatId         BigInt         @map("chat_id")
  accountId      Int            @map("account_id")
  personaSlug    String         @map("persona_slug")
  historyText    String         @map("history_text")
  createdAt      Int            @map("created_at")
  pendingReplyId Int?           @unique @map("pending_reply_id")
  task           VoiceTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  recording      VoiceRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  pendingReply   PendingReply?  @relation(fields: [pendingReplyId], references: [id], onDelete: SetNull)

  @@index([taskId, id])
  @@map("voice_deliveries")
}

model VoicerBotState {
  id           Int @id @default(1)
  nextUpdateId Int @default(0) @map("next_update_id")

  @@map("voicer_bot_state")
}

model VoiceCall {
  id             String              @id
  taskId         Int                 @map("task_id")
  task           VoiceTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  revision       Int
  accountId      Int                 @map("account_id")
  chatId         BigInt              @map("chat_id")
  voicerId       Int                 @map("voicer_id")
  status         String              @default("connecting")
  reason         String              @default("")
  createdAt      Int                 @map("created_at")
  connectedAt    Int?                @map("connected_at")
  endedAt        Int?                @map("ended_at")
  finalizedAt    Int?                @map("finalized_at")
  resumeStatus   String              @default("pending") @map("resume_status")
  followupStatus String              @default("none") @map("followup_status")
  note           String              @default("")
  recording      VoiceCallRecording?

  @@index([taskId, createdAt])
  @@map("voice_calls")
}

/// Диктофон: запись звонка из кабинета, обе стороны, подпись ставит войсер после звонка.
model VoiceCallRecording {
  id        Int       @id @default(autoincrement())
  callId    String    @unique @map("call_id")
  call      VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  taskId    Int       @map("task_id")
  task      VoiceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  filePath  String    @map("file_path")
  duration  Int
  createdAt Int       @map("created_at")
  /// когда войсер подписал запись; пусто — стоит подпись по умолчанию
  titledAt  Int?      @map("titled_at")

  @@index([taskId, id])
  @@map("voice_call_recordings")
}

/// Отклонённые из буфера лиды: сам лид удаляется, а здесь остаётся слепок —
/// чтобы было видно, что этого собеседника уже когда-то отклоняли.
model DeclinedLead {
  id           Int     @id @default(autoincrement())
  phoneE164    String? @map("phone_e164")
  usernameKey  String? @map("username_key")
  regionCode   String? @map("region_code")
  /// все поля лида на момент отклонения, JSON
  snapshot     String
  reason       String?
  declinedAt   Int     @map("declined_at")
  declinedById Int?    @map("declined_by_id")

  @@index([usernameKey], map: "idx_declined_leads_username")
  @@index([phoneE164], map: "idx_declined_leads_phone")
  @@map("declined_leads")
}

/// Настройки региона для входящих лидов. Нет строки — всё выключено.
model RegionSetting {
  regionCode       String  @id @map("region_code")
  /// принимать перезабив (reassigned=true); выключено — такие лиды отбиваются
  acceptReassigned Boolean @default(false) @map("accept_reassigned")
  /// принимать холодку: её получают сотрудники региона с включённой холодкой
  acceptCold       Boolean @default(false) @map("accept_cold")
  updatedAt        Int     @map("updated_at")
  updatedById      Int?    @map("updated_by_id")

  @@map("region_settings")
}
