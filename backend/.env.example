# --- HTTP ---
PORT=8011
# Comma-separated origins allowed by CORS (the Vite dev server of the manager panel).
CORS_ORIGINS=http://localhost:5173
# Public HTTPS cabinet address used in voicer bot conversation links.
VOICER_PANEL_URL=

# --- Auth (JWT bearer, roles admin/manager/voice) ---
JWT_SECRET=replace-with-a-long-random-secret
# Seeded on first start when no user exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# --- Database (PostgreSQL) ---
# For local work the compose file in the repository root already starts one;
# point this at it, or at any other instance.
DATABASE_URL=postgresql://nastya:nastya@127.0.0.1:5436/nastya_test?schema=public

# --- Telegram client accounts (MTProto via GramJS) ---
# From https://my.telegram.org — one application for the whole fleet.
TG_API_ID=
TG_API_HASH=
# 32-byte hex key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts stored sessions and proxy credentials at rest.
SESSION_ENC_KEY=

# --- LLM (Anthropic API directly: prompt caching is what keeps the judges affordable) ---
ANTHROPIC_API_KEY=
# Only for an organisation-wide key (console: Settings → Workspaces → ID, wrkspc_...); a workspace-scoped key does not need it.
ANTHROPIC_WORKSPACE_ID=
# Generator: claude-sonnet-5 (default) or claude-opus-5. Judges are always claude-opus-5.
GENERATOR_MODEL=claude-sonnet-5
# Thinking depth of the judges: low (default, cheapest) | medium | high
JUDGE_EFFORT=low

# --- Persona and data ---
PERSONA_ID=nastya
PERSONAS_DIR=./data/personas
DATA_DIR=./data

# --- Cold outreach (leads pool -> first message) ---
# New contacts per account per Moscow day; keep low on fresh accounts.
OUTREACH_DAILY_PER_ACCOUNT=10
# Minimum seconds between two openers from one account.
OUTREACH_MIN_GAP_S=180
# Waking hours, Moscow time.
OUTREACH_HOURS_MSK=10-21

# ── Модель: напрямую Anthropic или через OpenRouter ─────────────────────────
# LLM_PROVIDER=openrouter — все вызовы (судьи, ответ, фото) идут через OpenRouter.
LLM_PROVIDER=anthropic
OPENROUTER_API_KEY=

# Свой шлюз к Claude (OpenRouter-совместимый /v1/chat/completions). Запросы
# к модели сначала идут в него, при ошибке — в OpenRouter. Пусто — выключено.
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_TIMEOUT_S=90
# Провайдеры Claude на OpenRouter через запятую. Только anthropic — чтобы кеш промпта не промахивался.
OPENROUTER_PROVIDERS=anthropic

# Расшифровка голосовых и кружков: OpenAI audio/transcriptions. Без ключа бот отвечает
# на голосовое «не разобрала, напиши текстом».
# Модель судей: claude-opus-5 (по умолчанию) или claude-opus-5.5 (новее и дешевле).
JUDGE_MODEL=

OPENAI_API_KEY=
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TRANSCRIBE_LANGUAGE=ru

# Отдельный бот для заданий войсерам; секрет задаётся только на сервере.
VOICER_BOT_TOKEN=

# Предупреждение в группу Telegram, когда на OpenRouter меньше порога (долларов).
# Бот должен быть добавлен в группу; CHAT_ID группы вида -100…; пусто — выключено.
# BOT_TOKEN не задан — пишет бот войсеров (VOICER_BOT_TOKEN).
BALANCE_ALERT_CHAT_ID=
BALANCE_ALERT_BOT_TOKEN=
BALANCE_ALERT_THRESHOLD=300
# Пока баланс низкий, напоминать раз в N часов.
BALANCE_ALERT_REPEAT_HOURS=12

# Сторож: если бэкенд не отвечает дольше N секунд (завис), процесс
# перезапускается сам. 0 — выключено.
WATCHDOG_STALL_S=120
#33