# Скопируйте в .env и заполните. Этот файл читают контейнеры бэкенда и базы.
# Пути к данным и адрес базы задаёт docker-compose.yml — здесь их нет.

DATA_ROOT=/srv/persona-data

# --- Память PostgreSQL ---
# Умолчания в docker-compose.yml рассчитаны на 16 ГБ. На машине поменьше
# задайте здесь свои значения, например для 4 ГБ:
# PG_SHARED_BUFFERS=768MB
# PG_EFFECTIVE_CACHE_SIZE=2GB
# PG_WORK_MEM=16MB
# PG_MAINTENANCE_WORK_MEM=128MB

# --- База (PostgreSQL) ---
# Пароль придумайте свой; он попадает в адрес подключения, поэтому не используйте
# в нём @ : / ? # — иначе адрес придётся кодировать вручную.
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
POSTGRES_DB=nastya
POSTGRES_USER=nastya

# --- Панель ---
# Порт, на котором панель и API отвечают на этой машине.
PANEL_PORT=8080
# Адрес кабинета снаружи: по нему бот войсера собирает ссылки на задания.
VOICER_PANEL_URL=http://localhost:8080
# Панель и API на одном адресе, поэтому CORS нужен только для разработки.
CORS_ORIGINS=

# --- Вход в панель ---
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Заводится при первом запуске, если пользователей ещё нет.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Telegram-аккаунты личностей (MTProto) ---
# Одно приложение на весь парк: https://my.telegram.org
TG_API_ID=
TG_API_HASH=
# Шифрует сохранённые сессии и данные прокси. Потеряете этот ключ — все аккаунты
# придётся заводить заново:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENC_KEY=

# --- Модели ---
# Через OpenRouter (llm_provider=openrouter) или напрямую в Anthropic.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Генератор ответов и модель судей; пусто — значения по умолчанию.
GENERATOR_MODEL=
JUDGE_MODEL=

# --- Расшифровка голосовых (необязательно) ---
OPENAI_API_KEY=

# --- Бот для войсеров (необязательно) ---
# Отдельный бот без webhook; пусто — бот просто не включается.
VOICER_BOT_TOKEN=
